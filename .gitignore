# C++
**/cmake-build*/
**/build*/
**/*.so
**/*.log*

# Omniverse
**/*.dmp
**/.thumbs

# No USD files allowed in the repo
**/*.usd
**/*.usda
**/*.usdc
**/*.usdz

# Python
.DS_Store
**/*.egg-info/
**/__pycache__/
**/.pytest_cache/
**/*.pyc
**/*.pb

# Docker/Singularity
**/*.sif
docker/cluster/exports/
docker/.container.cfg

# IDE
**/.idea/
**/.vscode/
# Don't ignore the top-level .vscode directory as it is
# used to configure VS Code settings
!.vscode

# Outputs
# Ignore report payloads but keep the markdown conventions/manifests committable.
# Archived logs stay ignored via the **/*.log* rule above.
/reports/**
!/reports/**/
!/reports/**/README.md
!/reports/**/*.md
**/output/*
**/outputs/*
**/videos/*
**/wandb/*
**/.neptune/*
docker/artifacts/
*.tmp

# Doc Outputs
**/docs/_build/*
**/generated/*

# Isaac-Sim packman
_isaac_sim*
_repo
_build
.lastformat

# RL-Games
**/runs/*
**/logs/*
**/recordings/*

# Pre-Trained Checkpoints
/.pretrained_checkpoints/

# Teleop Recorded Dataset
/datasets/

# Tests
/tests/

# Docker history
.isaac-lab-docker-history

# TacSL sensor
**/tactile_record/*
**/gelsight_r15_data/*

# No benchmarks output
/benchmarks/

# Ruff cache
**/.ruff_cache/

# Dev-time files, generated stuff
**/__*

# Isaac Lab CI environments in native mode
**/_isaaclab_install_ci_*

# Superpowers (Claude Code plugin artifacts)
docs/superpowers/

# PACE sim2real identification data (chirp captures, plots)
/data/

# real Mid-360 rosbag (770 MB) kept next to the task for analysis, never committed
source/isaaclab_tasks/isaaclab_tasks/direct/parkour_imitation/real_lidar/*.db3
source/isaaclab_tasks/isaaclab_tasks/direct/parkour_imitation/real_lidar/metadata.yaml
