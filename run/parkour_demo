#!/usr/bin/env bash
# run/parkour_demo — headless 녹화 sweep (test 지형, 5종 x 11난이도 기본)
#
# 사용법:
#   ./run/parkour_demo                                  # 전체 sweep (기본 체크포인트)
#   ./run/parkour_demo --cam_view side --max_frames 1000
#   ./run/parkour_demo --record_classes stair --record_levels 0,5,10 --video_dir logs/demo_videos
#   ./run/parkour_demo --checkpoint <다른.pt>           # 체크포인트 교체
#
# 공통으로 박혀있는 것: conda(isaac-5.1) + Go2-ParkourDemo-v0 + --record --headless --enable_cameras
# 변경 인자만 뒤에 붙이면 됩니다. 기본 체크포인트는 PARKOUR_CKPT 환경변수로 덮어쓸 수 있습니다.
set -euo pipefail

# run/ 한 단계 위가 저장소 루트
REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
DEFAULT_CKPT="${PARKOUR_CKPT:-$REPO/logs/rsl_rl/parkour_imitation_go2_symmetry/2026-06-15_18-06-15_amp_4.0/model_12600.pt}"

# conda 활성화
source "$(conda info --base 2>/dev/null || echo /home/user/miniconda3)/etc/profile.d/conda.sh"
conda activate isaac-5.1

cd "$REPO"

# 사용자가 --checkpoint를 안 줬으면 기본값 주입
EXTRA=()
if [[ " $* " != *" --checkpoint "* ]]; then
    EXTRA+=(--checkpoint "$DEFAULT_CKPT")
fi

exec ./isaaclab.sh -p scripts/reinforcement_learning/rsl_rl/play_parkour_demo.py \
    --task Go2-ParkourDemo-v0 --record --headless --enable_cameras \
    "${EXTRA[@]}" "$@"
